# =============================================================================
# Drift Backend – Environment Variables
# Copy to .env and fill in your values
# =============================================================================

# --- Server ---
PORT=3001
NODE_ENV=development
API_SECRET=your-api-secret-min-32-chars-long

# --- Supabase ---
SUPABASE_URL=https://lbdiixdgsbhryulutpef.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRICE_PRO_MONTHLY=price_your-pro-monthly-price-id
STRIPE_PRICE_PRO_YEARLY=price_your-pro-yearly-price-id
STRIPE_PRICE_TEAM_MONTHLY=price_your-team-monthly-price-id
STRIPE_PRICE_TEAM_YEARLY=price_your-team-yearly-price-id

# --- Anthropic (Claude AI) ---
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# --- Email (SMTP) ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_your-resend-api-key
EMAIL_FROM=Drift <hello@getdrift.app>

# --- Redis (optional, for rate limiting & caching) ---
REDIS_URL=redis://localhost:6379

# --- Frontend ---
FRONTEND_URL=https://getdrift.app
EXTENSION_ID=your-chrome-extension-id
